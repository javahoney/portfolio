---
interface Props {
	text: string;
	srHeading?: boolean;
}

const { text, srHeading = false } = Astro.props;
---

<div class="compact-label">
	<span class="badge">{text}</span>
</div>
{srHeading && <h2 class="sr-only">{text}</h2>}

<style>
	.compact-label {
		display: flex;
		align-items: center;
		margin-bottom: 24px;
	}
</style>
