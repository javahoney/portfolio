---
import WhatsAppIcon from "./WhatsAppIcon.astro";

const email = "contact@alexandre-lobo.com";
const mailtoHref = `mailto:${email}`;

const whatsappHref = "https://wa.me/33773532515";
---

<footer class="footer">
	<div class="footer__grid">
		<div class="footer__col footer__col--identity">
			<p class="footer__name"><span class="small-caps-first">A</span><span class="small-caps-rest">lexandre</span> <span class="small-caps-first">L</span><span class="small-caps-rest">obo</span></p>
			<a class="footer__email" href={mailtoHref} target="_blank" rel="noopener noreferrer">{email}</a>
			<div class="footer__socials">
				<a
					class="footer__social"
					href="https://www.linkedin.com/in/alexandre-lobo-274890326"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
				>
					<svg width="18" height="18" viewBox="0 0 448 512" fill="currentColor">
						<path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"></path>
					</svg>
				</a>
				<a
					class="footer__social"
					href={whatsappHref}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="WhatsApp"
				>
					<WhatsAppIcon size={18} />
				</a>
			</div>
		</div>
	</div>

	<div class="footer__bottom">
		<p class="footer__bottom-text">© 2026 · Alexandre Lobo · SIRET 989 159 660 00012</p>
		<p class="footer__bottom-text">Basé à Orléans · À distance dans toute la France</p>
	</div>
</footer>


<style>
	.footer {
		background: linear-gradient(135deg, #00259e 0%, #001e7e 100%);
		color: #fff;
	}

	.footer__grid {
		max-width: 1400px;
		margin: 0 auto;
		padding: 96px 48px 64px;
	}

	.footer__col {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.footer__name {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: #fff;
		font-size: 1rem;
	}

	.footer__name .small-caps-rest {
		text-transform: uppercase;
		font-size: 0.78em;
	}

	.footer__email {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 4px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		letter-spacing: -0.03em;
		transition: text-decoration-thickness 0.2s ease-out;
	}

	.footer__email:hover {
		text-decoration-thickness: 2px;
	}

	.footer__socials {
		display: flex;
		gap: 16px;
		margin-top: 8px;
	}

	.footer__social {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background: #fff;
		color: #00259e;
		border-radius: 0;
		transition: background-color 0.2s ease-out, color 0.2s ease-out;
	}

	.footer__social:hover {
		background: #001e7e;
		color: #fff;
	}

	.footer__bottom {
		max-width: 1400px;
		margin: 0 auto;
		padding: 24px 48px 40px;
		border-top: 1px solid rgba(255, 255, 255, 0.2);
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
	}

	.footer__bottom-text {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #b1bce0;
	}

	@media (max-width: 900px) {
		.footer__grid {
			padding: 64px 12px 40px;
		}

		.footer__bottom {
			flex-direction: column;
			padding: 24px 12px 32px;
		}
	}
</style>
