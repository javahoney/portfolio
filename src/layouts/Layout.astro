---
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description?: string;
	image?: string;
	structuredData?: Record<string, unknown> | string;
	noindex?: boolean;
}

const DEFAULT_IMAGE = "/images/photo-profil.png";

const { title, description, image = DEFAULT_IMAGE, structuredData, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site).toString();
const structuredDataJson =
	typeof structuredData === "string" ? structuredData : structuredData ? JSON.stringify(structuredData) : undefined;
---

<html lang="fr">
	<head>
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-KF6VD348');</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalURL} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Alexandre Lobo" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={imageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={imageURL} />

		{structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} is:inline />}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Montserrat:ital,wght@0,500;0,600;1,300;1,600&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />
		<script>
			// Pas de transition quand la navigation cible la page déjà affichée
			// (même pathname). Un class/attribut custom sur <html> ne survivrait
			// pas : swapRootAttributes() (astro/dist/transitions/swap-functions.js)
			// efface tous les attributs du <html> au moment du swap, sauf les deux
			// attributs internes d'Astro (data-astro-transition[-fallback]) qu'il
			// préserve explicitement — donc pas moyen de passer par une classe/attr
			// perso pour conditionner le CSS. On utilise à la place l'API native :
			// event.viewTransition.skipTransition() sur astro:before-swap saute
			// l'animation sans empêcher le swap du DOM qui suit dans tous les cas.
			document.addEventListener("astro:before-swap", (event) => {
				if (event.from.pathname === event.to.pathname) {
					event.viewTransition.skipTransition();
				}
			});
		</script>
	</head>
	<body>
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KF6VD348"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<slot />
	</body>
</html>

<style is:global>
	html {
		box-sizing: border-box;
	}
	*,
	*::before,
	*::after {
		box-sizing: inherit;
	}
	body {
		margin: 0;
		background: #fafafa;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.eyebrow {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: #00259e;
	}

	.badge {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		margin: 0;
		padding: 3px 8px;
		border-radius: 6px;
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.875rem;
		text-transform: uppercase;
		font-variant-caps: all-small-caps;
		letter-spacing: 0.04em;
		text-align: center;
		color: #fff;
		background-color: #00259e;
	}

	.badge::before {
		content: "";
		position: absolute;
		top: 0;
		left: -75%;
		width: 50%;
		height: 100%;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.9) 50%, rgba(255, 255, 255, 0) 100%);
		mix-blend-mode: screen;
		pointer-events: none;
		animation: badge-shine 5s ease-in-out infinite;
	}

	@keyframes badge-shine {
		0% {
			left: -75%;
		}
		30% {
			left: 125%;
		}
		100% {
			left: 125%;
		}
	}

	.icon-mask {
		display: inline-block;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-size: contain;
		mask-size: contain;
	}

	.icon-mask--on-dark {
		background: linear-gradient(90deg, #ffffff 0%, #ecf7e4 10%, #ecf7e4 90%, #ffffff 100%);
	}

	.icon-mask--on-light {
		background: linear-gradient(90deg, #4f69b8 0%, #00259e 100%);
	}

	.diamond {
		width: 8px;
		height: 8px;
		background: #00259e;
		transform: rotate(45deg);
		flex-shrink: 0;
	}

	.diamond--white {
		background: #fff;
	}

	.btn {
		display: inline-block;
		text-decoration: none;
		border-radius: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 12px 24px;
		transition: background-color 0.2s ease-out, color 0.2s ease-out;
	}

	.btn--primary {
		background: #00259e;
		color: #fff;
		border: 1px solid transparent;
	}

	.btn--primary:hover {
		background: #001e7e;
		color: #fff;
	}

	.btn--on-dark {
		background: #fff;
		color: #00259e;
		border: 1px solid transparent;
	}

	.btn--on-dark:hover {
		background: #ecf7e4;
		color: #00259e;
	}

	.btn--secondary {
		background: #ffffff;
		color: #00259e;
		border: 1px solid #00259e;
	}

	.btn--secondary:hover {
		background: #00259e;
		color: #fff;
		border-color: #00259e;
	}

	.navlink {
		display: inline-block;
		background: #00259e;
		color: #fff;
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		text-decoration: none;
		padding: 8px 16px;
		border-radius: 0;
		transition: background-color 0.2s ease-out, color 0.2s ease-out;
	}

	.navlink:hover {
		background: #001e7e;
		color: #fff;
	}

	.navlink--on-dark {
		display: inline-block;
		background: #fff;
		color: #00259e;
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		text-decoration: none;
		padding: 8px 16px;
		border-radius: 0;
		transition: background-color 0.2s ease-out, color 0.2s ease-out;
	}

	.navlink--on-dark:hover {
		background: #ecf7e4;
		color: #00259e;
	}

	.text-link {
		color: #00259e;
		text-decoration: underline;
		text-underline-offset: 4px;
		transition: text-decoration-thickness 0.2s ease-out;
	}

	.text-link:hover {
		text-decoration-thickness: 2px;
	}

	.section {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 48px 120px;
	}

	.section-title {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 64px;
	}

	.section-title__line {
		flex: 1;
		height: 2px;
		background: #00259e;
	}

	.section-title__text {
		margin: 0;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.04em;
		font-size: clamp(2.25rem, 4vw, 3rem);
		line-height: 1.06;
		color: #00259e;
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.section {
			padding: 0 12px 64px;
		}

		.section-title {
			margin-bottom: 40px;
		}

		.section-title__text {
			font-size: 2rem;
		}
	}

	/* Transition de page : la page sortante glisse seule vers le haut, lente et
	   sans rebond. La page entrante reste invisible pendant tout ce temps
	   (elle est empilée par-dessus, donc si elle apparaissait tout de suite
	   elle masquerait la sortie) puis surgit en fondu rapide juste à la fin. */
	@keyframes slide-up-out {
		35% {
			opacity: 0;
		}
		to {
			transform: translateY(-100%);
			opacity: 0;
		}
	}

	@keyframes fade-in-quick {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	/* Neutralise le morph par défaut du navigateur sur le groupe racine :
	   les pages n'ayant pas toutes la même hauteur, Chrome anime par défaut
	   la largeur/hauteur du conteneur avec son propre easing (~0.25s ease),
	   en parallèle de nos animations sur old/new — ce décalage de timing est
	   ce qui produisait un effet de rebond résiduel. On aligne sa durée et
	   son easing sur la séquence complète pour qu'il ne joue plus son propre
	   mouvement. */
	::view-transition-group(root) {
		animation-duration: 0.75s;
		animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}

	::view-transition-old(root) {
		animation: slide-up-out 0.7s cubic-bezier(0.4, 0, 0.2, 1) both;
	}

	::view-transition-new(root) {
		/* fill-mode "both" applique opacity:0 (première image clé) pendant
		   tout le délai : la page entrante reste donc invisible le temps que
		   la sortie se joue, et n'apparaît qu'à la fin, rapidement. */
		animation: fade-in-quick 0.25s ease-out 0.5s both;
	}

	@media (prefers-reduced-motion: reduce) {
		::view-transition-group(*),
		::view-transition-old(*),
		::view-transition-new(*) {
			animation: none !important;
		}
	}
</style>
