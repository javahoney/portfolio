---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";

const email = "contact@alexandre-lobo.com";
const subject = "Nouveau projet";
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<Layout
	title="Page introuvable — Alexandre Lobo"
	description="Cette page n'existe pas ou a été déplacée. Retournez à l'accueil pour retrouver les sites web et la rédaction technique d'Alexandre Lobo."
	noindex
>
	<Topbar href={mailtoHref} variant="on-light" />

	<main class="not-found">
		<p class="eyebrow">Erreur 404</p>
		<h1 class="not-found__title">Cette page n'existe pas.</h1>
		<p class="not-found__text">Elle a peut-être été déplacée ou n'existe plus.</p>
		<a class="btn btn--primary" href="/">Retour à l'accueil</a>
	</main>

	<Footer />
</Layout>

<style>
	.not-found {
		max-width: 1400px;
		margin: 0 auto;
		min-height: 60vh;
		padding: 40px 48px 96px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 24px;
	}

	.not-found__title {
		margin: 0;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: #00259e;
		font-size: clamp(2.25rem, 5vw, 3.5rem);
	}

	.not-found__text {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: #333333;
	}

	@media (max-width: 640px) {
		.not-found {
			padding: 64px 12px;
			min-height: 50vh;
		}
	}
</style>
