---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";

const description =
	"Conception de sites vitrines performants pour indépendants et petites entreprises. Un process clair, du design à la mise en ligne, et une autonomie totale pour piloter votre site une fois livré.";

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Alexandre Lobo",
	jobTitle: "Web Designer & Developer",
	url: "https://alexandre-lobo.com",
	sameAs: ["https://www.linkedin.com/in/alexandre-lobo-274890326"],
};
---

<Layout title="Alexandre Lobo — Sites vitrines performants, pilotés en autonomie" description={description} structuredData={personSchema}>
	<Nav />

	<main>
		<section class="section" id="approche">
			<SectionTitle text="Mon approche" />

			<div class="approach">
				<div class="approach__row">
					<p class="approach__text">Je pars de vos objectifs business,<br />et je construis autour.</p>
					<span class="approach__icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00259E" stroke-width="1.5">
							<rect x="3" y="7" width="18" height="12"></rect>
							<path d="M8 7V5C8 4 8.5 3 10 3H14C15.5 3 16 4 16 5V7"></path>
							<line x1="3" y1="12" x2="21" y2="12"></line>
						</svg>
					</span>
				</div>
				<div class="approach__row">
					<p class="approach__text">Conception de sites vitrines,<br />du design à la mise en ligne.</p>
					<span class="approach__icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00259E" stroke-width="1.5">
							<circle cx="12" cy="12" r="9"></circle>
							<ellipse cx="12" cy="12" rx="4" ry="9"></ellipse>
							<line x1="3" y1="12" x2="21" y2="12"></line>
						</svg>
					</span>
				</div>
				<div class="approach__row">
					<p class="approach__text">Autonomie totale à la livraison,<br />je vous forme à piloter votre site seul.</p>
					<span class="approach__icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00259E" stroke-width="1.5">
							<path d="M21 3L3 10.5L11 13L21 3Z"></path>
							<path d="M11 13L14 21L21 3" stroke-linejoin="round"></path>
						</svg>
					</span>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.approach {
		display: flex;
		flex-direction: column;
	}

	.approach__row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 32px 0;
	}

	.approach__row + .approach__row {
		border-top: 1px solid #e5e5e5;
	}

	.approach__text {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: #333333;
		max-width: 640px;
	}

	.approach__icon {
		flex-shrink: 0;
		display: flex;
	}

	@media (max-width: 640px) {
		.approach__row {
			gap: 16px;
			padding: 24px 0;
		}
	}
</style>
