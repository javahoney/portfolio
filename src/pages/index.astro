---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CompactLabel from "../components/CompactLabel.astro";
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";

const email = "contact@alexandre-lobo.com";
const mailtoHref = `mailto:${email}`;
const whatsappHref = "https://wa.me/33773532515";

const homeProjectIds = ["gemilio", "yann-mokoko", "le-paris", "quiet-details"];
const homeProjects = await Promise.all(
	homeProjectIds.map(async (id) => {
		const entry = await getEntry("projects", id);
		if (!entry) throw new Error(`Project entry not found: ${id}`);
		return entry;
	})
);

const description = "Création de sites web sur-mesure pour PME et entrepreneurs : design, SEO et évolutivité, sans développeur.";

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Alexandre Lobo",
	jobTitle: "Web Designer & Developer",
	url: "https://alexandre-lobo.com",
	sameAs: ["https://www.linkedin.com/in/alexandre-lobo-274890326"],
};
---

<Layout
	title="Alexandre Lobo — Création et refonte de site web"
	description={description}
	structuredData={personSchema}
>
	<section class="hp-hero">
		<Topbar href={mailtoHref} links={[{ label: "Projets", href: "/projets" }]} />
		<div class="hp-hero__inner">
			<div class="hp-hero__heading">
				<h1 class="hp-hero__title">Je crée des sites qui servent votre business</h1>
				<p class="hp-hero__subtitle">Je conçois des sites sur-mesure pour les PME et entrepreneurs qui veulent un site design, visible sur Google, et facile à faire évoluer sans développeur.</p>
				<div class="hp-hero__cta">
					<a class="btn btn--secondary" href="/projets">Voir tous mes projets</a>
					<a class="btn btn--on-dark" href={whatsappHref} target="_blank" rel="noopener noreferrer">Me contacter</a>
				</div>
			</div>

			<a class="hp-hero__photo-link" href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="Discuter avec moi sur WhatsApp">
				<img class="hp-hero__photo" src="/images/photo-profil.png" alt="Alexandre Lobo" />
				<span class="hp-hero__bubble" aria-hidden="true">
					<WhatsAppIcon size={14} />
					Discuter avec moi
				</span>
				<span class="hp-hero__ping" aria-hidden="true">
					<WhatsAppIcon size={16} />
				</span>
			</a>
		</div>
	</section>

	<main>
		<section class="section hp-pitch">
			<CompactLabel text="Pourquoi moi" srHeading />
			<div class="hp-pitch-grid">
				<div class="hp-pitch-card">
					<h3 class="hp-pitch-card__title">Un site pensé business</h3>
					<p class="hp-pitch-card__text">Chaque page est construite pour attirer et convaincre, en combinant un design impactant et une base SEO optimisée.</p>
				</div>
				<div class="hp-pitch-card">
					<h3 class="hp-pitch-card__title">Renforcez l'image de marque</h3>
					<p class="hp-pitch-card__text">Chaque site doit être unique pour refléter votre identité. Je crée un site à votre image, en harmonie avec votre marque et vos enjeux.</p>
				</div>
				<div class="hp-pitch-card">
					<h3 class="hp-pitch-card__title">Prenez le contrôle de votre site</h3>
					<p class="hp-pitch-card__text">Je développe votre site comme un outil business qui évolue, je le pense de manière à ce que vous soyez entièrement autonome sur votre contenu.</p>
				</div>
			</div>
		</section>

		<section class="section hp-work">
			<CompactLabel text="Travaux" />
			<h2 class="hp-work__heading">Mes réalisations</h2>
			<div class="hp-work-grid">
				{homeProjects.map((project) => (
					<a class="hp-work-item" href={`/projets/${project.id}`}>
						<div class="hp-work-item__media">
							{project.data.mainImage ? (
								<Image class="hp-work-item__media-inner" src={project.data.mainImage} alt={project.data.name} width={800} loading="lazy" />
							) : (
								<div class="hp-work-item__media-inner" aria-hidden="true"></div>
							)}
						</div>
						<h3 class="hp-work-item__name">{project.data.name}</h3>
						<p class="hp-work-item__meta">{project.data.category}</p>
					</a>
				))}
			</div>
			<a class="btn btn--primary hp-work__all" href="/projets">Tous les projets →</a>
		</section>

		<section class="section hp-contact">
			<CompactLabel text="Contact" />
			<h2 class="hp-contact__heading">Écrivez-moi.</h2>
			<p class="hp-body">Réponse sous 24 h ouvrées.</p>
			<div class="hp-contact__actions">
				<a class="btn btn--primary" href={mailtoHref} target="_blank" rel="noopener noreferrer">Me contacter</a>
				<a class="text-link" href={mailtoHref} target="_blank" rel="noopener noreferrer">{email}</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	function setupHeroBubble() {
		const link = document.querySelector(".hp-hero__photo-link");
		const bubble = document.querySelector(".hp-hero__bubble");
		if (!link || !bubble) return;

		link.addEventListener("mousemove", (event) => {
			const rect = link.getBoundingClientRect();
			bubble.style.left = `${event.clientX - rect.left}px`;
			bubble.style.top = `${event.clientY - rect.top}px`;
		});
	}

	document.addEventListener("astro:page-load", setupHeroBubble);
</script>

<style>
	.hp-hero {
		background: linear-gradient(135deg, #00259e 0%, #001e7e 100%);
	}

	.hp-hero__inner {
		max-width: 1400px;
		margin: 0 auto;
		padding: 64px 48px 96px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 64px;
	}

	.hp-hero__heading {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}

	.hp-hero__title {
		margin: 0;
		max-width: 640px;
		font-family: "Montaga", serif;
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1.04;
		color: #fff;
		font-size: clamp(3rem, 5.5vw, 4.25rem);
	}

	.hp-hero__subtitle {
		margin: 0;
		max-width: 560px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: #fff;
	}

	.hp-hero__cta {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.hp-hero__photo-link {
		position: relative;
		flex-shrink: 0;
		display: block;
		width: 150px;
		height: 150px;
		text-decoration: none;
	}

	.hp-hero__photo-link:hover {
		cursor: none;
	}

	.hp-hero__photo {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		object-position: center top;
		display: block;
		animation: hp-glow 5s ease-in-out infinite;
	}

	.hp-hero__bubble {
		position: absolute;
		top: 0;
		left: 0;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		transform: translate(-50%, -130%);
		background: #25d366;
		color: #fff;
		white-space: nowrap;
		padding: 12px 20px;
		border-radius: 999px;
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.9375rem;
		letter-spacing: -0.03em;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease-out;
	}

	.hp-hero__photo-link:hover .hp-hero__bubble {
		opacity: 1;
	}

	@keyframes hp-glow {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.15);
		}
		50% {
			box-shadow: 0 0 18px 5px rgba(255, 255, 255, 0.3);
		}
	}

	.hp-hero__ping {
		position: absolute;
		top: -4px;
		right: -4px;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: #25d366;
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transform: scale(0.6);
		pointer-events: none;
		animation: hp-ping 6s ease-in-out infinite;
	}

	@keyframes hp-ping {
		0% {
			opacity: 0;
			transform: scale(0.6);
		}
		8% {
			opacity: 1;
			transform: scale(1);
		}
		30% {
			opacity: 1;
			transform: scale(1);
		}
		38% {
			opacity: 0;
			transform: scale(0.6);
		}
	}

	.hp-body {
		margin: 0 0 24px;
		max-width: 680px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.hp-body:last-of-type {
		margin-bottom: 0;
	}

	.hp-pitch {
		padding-top: 96px;
	}

	.hp-pitch-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.hp-pitch-card {
		position: relative;
		overflow: hidden;
		background: #fff;
		border: 1px solid #e5e5e5;
		padding: 40px;
		transition: border-color 0.2s ease-out;
	}

	.hp-pitch-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: -60%;
		width: 40%;
		height: 100%;
		background: linear-gradient(135deg, rgba(0, 37, 158, 0) 0%, rgba(0, 37, 158, 0.025) 50%, rgba(0, 37, 158, 0) 100%);
		pointer-events: none;
	}

	.hp-pitch-card:hover {
		border-color: #00259e;
	}

	.hp-pitch-card:hover::before {
		animation: hp-pitch-card-shine 0.35s ease-out;
	}

	@keyframes hp-pitch-card-shine {
		0% {
			left: -60%;
		}
		100% {
			left: 120%;
		}
	}

	.hp-pitch-card__title {
		margin: 0 0 12px;
		font-family: "Montaga", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		font-size: 1.5rem;
		color: #00259e;
	}

	.hp-pitch-card__text {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.hp-work {
		padding-top: 0;
	}

	.hp-work__heading {
		margin: 0 0 24px;
		font-family: "Montaga", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.06;
		color: #00259e;
		font-size: clamp(2rem, 4vw, 2.75rem);
	}

	.hp-work-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.hp-work-item {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.hp-work-item__media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.hp-work-item__media-inner {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
		background: linear-gradient(135deg, #dde5f0, #c2cee0);
		transition: transform 0.4s ease-out;
	}

	.hp-work-item:hover .hp-work-item__media-inner {
		transform: scale(1.03);
	}

	.hp-work-item__name {
		margin: 16px 0 8px;
		font-family: "Montaga", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		font-size: 1.5rem;
		color: #00259e;
	}

	.hp-work-item__meta {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.hp-work__all {
		display: inline-block;
		margin-top: 40px;
	}

	.hp-contact__heading {
		margin: 0 0 24px;
		font-family: "Montaga", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.06;
		color: #00259e;
		font-size: clamp(2rem, 4vw, 2.75rem);
	}

	.hp-contact__actions {
		margin-top: 24px;
		display: flex;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}

	@media (max-width: 640px) {
		.hp-hero__inner {
			padding: 40px 12px 64px;
			gap: 40px;
			flex-direction: column;
			align-items: flex-start;
		}

		.hp-hero__title {
			font-size: 2.5rem;
		}

		.hp-hero__photo-link {
			width: 110px;
			height: 110px;
		}

		.hp-pitch {
			padding-top: 64px;
		}

		.hp-pitch-grid {
			grid-template-columns: 1fr;
		}

		.hp-pitch-card {
			padding: 24px;
		}

		.hp-work-grid {
			grid-template-columns: 1fr;
		}

		.hp-work-item__media {
			aspect-ratio: 1 / 1;
		}
	}
</style>
