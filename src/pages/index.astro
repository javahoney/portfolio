---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CompactLabel from "../components/CompactLabel.astro";
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";

const email = "contact@alexandre-lobo.com";
const subject = "Nouveau projet";
const body = `Bonjour Alexandre,

Ce que je vends :
À qui :
URL de mon site actuel :

Merci !`;
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const homeProjectIds = ["gemilio", "yann-mokoko", "le-paris", "quiet-details"];
const homeProjects = await Promise.all(
	homeProjectIds.map(async (id) => {
		const entry = await getEntry("projects", id);
		if (!entry) throw new Error(`Project entry not found: ${id}`);
		return entry;
	})
);

const description = "Conception de sites web, refonte, SEO et rédaction technique pour les PME françaises.";

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Alexandre Lobo",
	jobTitle: "Web Designer & Developer",
	url: "https://alexandre-lobo.com",
	sameAs: ["https://www.linkedin.com/in/alexandre-lobo-274890326"],
};
---

<Layout
	title="Alexandre Lobo — Création et refonte de site web"
	description={description}
	structuredData={personSchema}
>
	<section class="hp-hero">
		<Topbar href={mailtoHref} links={[{ label: "Projets", href: "/projets" }]} />
		<div class="hp-hero__inner">
			<div class="hp-hero__heading">
				<h1 class="hp-hero__title">Webmaster au service de votre croissance</h1>
				<p class="hp-hero__subtitle">Parce que votre site mérite d'être aussi fort que votre vision. Je vous accompagne avec un process clair pour des résultats concrets.</p>
			</div>
			<a class="btn btn--on-dark" href={mailtoHref} target="_blank" rel="noopener noreferrer">Auditer mon site ►</a>
		</div>
	</section>

	<main>
		<section class="section hp-doors">
			<h2 class="sr-only">Sites web, rédaction technique et marque blanche</h2>
			<div class="hp-door-grid">
				<a class="hp-door" href="/pme-techniques">
					<h3 class="hp-door__title">Sites web</h3>
					<p class="hp-door__text">Conception, refonte, référencement. Contenu rédigé compris.</p>
					<span class="hp-door__link">Voir la prestation →</span>
				</a>
				<a class="hp-door" href="/redaction-technique">
					<h3 class="hp-door__title">Rédaction technique</h3>
					<p class="hp-door__text">Fiches produits, brochures, livres blancs. Sans refonte de site.</p>
					<span class="hp-door__link">Voir la prestation →</span>
				</a>
				<a class="hp-door" href="/marque-blanche">
					<h3 class="hp-door__title">Marque blanche</h3>
					<p class="hp-door__text">Production Webflow et Framer en white label pour vos projets de site vitrine.</p>
					<span class="hp-door__link">Voir la prestation →</span>
				</a>
			</div>
		</section>

		<section class="section hp-about">
			<div class="hp-about__layout">
				<div class="hp-about__content">
					<CompactLabel text="Qui je suis" />
					<h2 class="hp-about__heading">Votre webmaster</h2>
					<p class="hp-body">
						Webmaster, je gère votre site de A à Z. Passionné par les sciences et par le web, je vous accompagne
						sur la stratégie, l'univers graphique, le développement, la rédaction et le référencement. Je suis
						votre partenaire web qui a un seul objectif : vous accompagner pour atteindre vos chiffres grâce à une
						présence en ligne conçue pour vos clients.
					</p>
				</div>
				<img class="hp-about__photo" src="/images/photo-profil.png" alt="Alexandre Lobo" />
			</div>
		</section>

		<section class="section hp-work">
			<CompactLabel text="Travaux" />
			<h2 class="hp-work__heading">Mes réalisations</h2>
			<div class="hp-work-grid">
				{homeProjects.map((project) => (
					<a class="hp-work-item" href={`/projets/${project.id}`}>
						<div class="hp-work-item__media">
							{project.data.mainImage ? (
								<Image class="hp-work-item__media-inner" src={project.data.mainImage} alt={project.data.name} width={800} loading="lazy" />
							) : (
								<div class="hp-work-item__media-inner" aria-hidden="true"></div>
							)}
						</div>
						<h3 class="hp-work-item__name">{project.data.name}</h3>
						<p class="hp-work-item__meta">{project.data.category}</p>
					</a>
				))}
			</div>
			<a class="text-link hp-work__all" href="/projets">Tous les projets →</a>
		</section>

		<section class="section hp-contact">
			<CompactLabel text="Contact" />
			<h2 class="hp-contact__heading">Écrivez-moi.</h2>
			<p class="hp-body">Réponse sous 24 h ouvrées.</p>
			<div class="hp-contact__actions">
				<a class="btn btn--primary" href={mailtoHref} target="_blank" rel="noopener noreferrer">Écrire</a>
				<a class="text-link" href={mailtoHref} target="_blank" rel="noopener noreferrer">{email}</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.hp-hero {
		background: linear-gradient(135deg, #00259e 0%, #001e7e 100%);
	}

	.hp-hero__inner {
		max-width: 1400px;
		margin: 0 auto;
		padding: 64px 48px 96px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 64px;
	}

	.hp-hero__heading {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	.hp-hero__title {
		margin: 0;
		max-width: 800px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1.04;
		color: #fff;
		font-size: clamp(3rem, 5.5vw, 4.25rem);
	}

	.hp-hero__subtitle {
		margin: 0;
		max-width: 640px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: #fff;
	}

	.hp-body {
		margin: 0 0 24px;
		max-width: 680px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.hp-body:last-of-type {
		margin-bottom: 0;
	}

	.hp-about__layout {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.hp-about__photo {
		flex-shrink: 0;
		width: 112px;
		height: 112px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center top;
	}

	.hp-about__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.hp-doors {
		padding-top: 64px;
	}

	.hp-door-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.hp-door {
		position: relative;
		overflow: hidden;
		display: block;
		background: #fff;
		border: 1px solid #e5e5e5;
		padding: 40px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s ease-out;
	}

	.hp-door::before {
		content: "";
		position: absolute;
		top: 0;
		left: -60%;
		width: 40%;
		height: 100%;
		background: linear-gradient(135deg, rgba(0, 37, 158, 0) 0%, rgba(0, 37, 158, 0.025) 50%, rgba(0, 37, 158, 0) 100%);
		pointer-events: none;
	}

	.hp-door:hover {
		border-color: #00259e;
	}

	.hp-door:hover::before {
		animation: hp-door-shine 0.35s ease-out;
	}

	.hp-door:hover .hp-door__title {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	@keyframes hp-door-shine {
		0% {
			left: -60%;
		}
		100% {
			left: 120%;
		}
	}

	.hp-door__title {
		margin: 0 0 12px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		font-size: 1.5rem;
		color: #00259e;
	}

	.hp-door__text {
		margin: 0 0 24px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.hp-door__link {
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.875rem;
		letter-spacing: -0.03em;
		color: #00259e;
	}

	.hp-about__heading {
		margin: 0 0 24px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.06;
		color: #00259e;
		font-size: clamp(2.25rem, 4vw, 3rem);
	}

	.hp-work__heading {
		margin: 0 0 24px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.06;
		color: #00259e;
		font-size: clamp(2.25rem, 4vw, 3rem);
	}

	.hp-work-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.hp-work-item {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.hp-work-item__media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.hp-work-item__media-inner {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
		background: linear-gradient(135deg, #dde5f0, #c2cee0);
		transition: transform 0.4s ease-out;
	}

	.hp-work-item:hover .hp-work-item__media-inner {
		transform: scale(1.03);
	}

	.hp-work-item__name {
		margin: 16px 0 8px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		font-size: 1.5rem;
		color: #00259e;
	}

	.hp-work-item__meta {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.hp-work__all {
		display: inline-block;
		margin-top: 40px;
	}

	.hp-contact__heading {
		margin: 0 0 24px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.06;
		color: #00259e;
		font-size: clamp(2.25rem, 4vw, 3rem);
	}

	.hp-contact__actions {
		margin-top: 24px;
		display: flex;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}

	@media (max-width: 640px) {
		.hp-hero__inner {
			padding: 40px 12px 64px;
			gap: 24px;
		}

		.hp-hero__title {
			font-size: 2.5rem;
		}

		.hp-doors {
			padding-top: 40px;
		}

		.hp-about__layout {
			flex-direction: column;
			align-items: flex-start;
			gap: 24px;
		}

		.hp-about__photo {
			width: 96px;
			height: 96px;
		}

		.hp-door-grid {
			grid-template-columns: 1fr;
		}

		.hp-door {
			padding: 24px;
		}

		.hp-work-grid {
			grid-template-columns: 1fr;
		}

		.hp-work-item__media {
			aspect-ratio: 1 / 1;
		}
	}
</style>
