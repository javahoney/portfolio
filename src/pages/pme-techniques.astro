---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CompactLabel from "../components/CompactLabel.astro";
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";
import webIconUrl from "../icons/web-icon.svg?url";
import atomIconUrl from "../icons/atom-icon.svg?url";
import langageIconUrl from "../icons/write-icon.svg?url";
import parcoursIconUrl from "../icons/parcours-icon.svg?url";
import universIconUrl from "../icons/univers-icon.svg?url";
import moleculeIconUrl from "../icons/molecule-icon.svg?url";

const email = "contact@alexandre-lobo.com";
const subject = "Nouveau projet";
const body = `Bonjour Alexandre,

Ce que je vends :
À qui :
URL de mon site actuel :

Merci !`;
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const previewBody = `Bonjour Alexandre,

Ce que je vends :
À qui :
URL de mon site actuel :

Je veux voir à quoi mon site pourrait ressembler.

Merci d'avance`;
const previewMailtoHref = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(previewBody)}`;

const gemilio = await getEntry("projects", "gemilio");
if (!gemilio) throw new Error("Gemilio project entry not found");

const iconUrls = {
	webIconUrl: `url("${webIconUrl}")`,
	atomIconUrl: `url("${atomIconUrl}")`,
	langageIconUrl: `url("${langageIconUrl}")`,
	parcoursIconUrl: `url("${parcoursIconUrl}")`,
	universIconUrl: `url("${universIconUrl}")`,
	moleculeIconUrl: `url("${moleculeIconUrl}")`,
};

const studyData = [
	{ label: "Bon site web", count: 86, pct: 35, mark: "star" },
	{ label: "Pas de site web", count: 72, pct: 29, mark: "cross" },
	{ label: "Pas adapté mobile", count: 44, pct: 18 },
	{ label: "Problèmes d'affichage", count: 17, pct: 7 },
	{ label: "Contenu daté", count: 11, pct: 4 },
	{ label: "Liens internes cassés", count: 7, pct: 3 },
	{ label: "Incompréhensible", count: 4, pct: 2 },
	{ label: "Anormalement lent", count: 3, pct: 1 },
	{ label: "Erreur domaine", count: 2, pct: 1 },
];
const studyMax = Math.max(...studyData.map((row) => row.count));
const studyTotal = studyData.reduce((sum, row) => sum + row.count, 0);

const description =
	"Refonte de site et SEO pour les entreprises qui doivent expliquer leur produit avant de le vendre. À partir de 2 500 €, un mois.";

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	serviceType: "Web Development",
	description,
	provider: {
		"@type": "Person",
		name: "Alexandre Lobo",
		url: "https://alexandre-lobo.com",
	},
	areaServed: "France",
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "Offres site web pour PME techniques et scientifiques",
		itemListElement: [
			{
				"@type": "Offer",
				itemOffered: { "@type": "Service", name: "Refonte complète" },
				priceSpecification: { "@type": "PriceSpecification", minPrice: 2500, priceCurrency: "EUR" },
			},
			{
				"@type": "Offer",
				itemOffered: { "@type": "Service", name: "Abonnement" },
				priceSpecification: { "@type": "PriceSpecification", minPrice: 150, maxPrice: 350, priceCurrency: "EUR" },
			},
		],
	},
};
---

<Layout
	title="Sites web pour PME techniques et scientifiques — Alexandre Lobo"
	description={description}
	structuredData={serviceSchema}
>
	<section class="pt-hero">
		<Topbar href={mailtoHref} links={[]} />
		<div class="pt-hero__inner">
			<div class="pt-hero__main">
				<h1 class="pt-hero__title">
					J'ai analysé 246 PME scientifiques<span class="pt-hero__icon icon-mask icon-mask--on-dark pt-hero__icon--atom" aria-hidden="true"></span><br />
					35&nbsp;% ont un site correct<span class="pt-hero__icon icon-mask icon-mask--on-dark pt-hero__icon--web" aria-hidden="true"></span>
				</h1>

				<p class="pt-hero__subtitle">Parce que votre site mérite d'être aussi fort que votre vision. Je vous accompagne avec un process clair pour des résultats concrets.</p>

				<div class="pt-hero__cta">
					<a class="btn btn--on-dark" href={previewMailtoHref} target="_blank" rel="noopener noreferrer">Voir à quoi mon site pourrait ressembler</a>
					<p class="pt-hero__ctanote">Petite maquette gratuite sous 48h</p>
				</div>
			</div>

			<div class="pt-hero__visual">
				<div class="pt-data">
					<p class="pt-data__caption">Étude sur {studyTotal} sites vitrine · labos, biotech, pharma, instrumentation</p>
					<table class="pt-data__table">
						<caption class="sr-only">Répartition des {studyTotal} sites étudiés par catégorie</caption>
						<thead class="sr-only">
							<tr>
								<th scope="col">Catégorie</th>
								<th scope="col">Répartition</th>
								<th scope="col">Nombre</th>
							</tr>
						</thead>
						<tbody>
							{studyData.map((row) => (
								<tr>
									<th scope="row" class="pt-data__label">
									{row.label}
									{row.mark === "star" && <span class="pt-data__mark" aria-hidden="true">★</span>}
									{row.mark === "cross" && <span class="pt-data__mark" aria-hidden="true">✕</span>}
								</th>
									<td class="pt-data__cell">
										<div class="pt-data__track">
											<div class="pt-data__bar" style={`width:${(row.count / studyMax) * 100}%`}>
												<span class="pt-data__count">{row.count}</span>
											</div>
										</div>
									</td>
									<td class="pt-data__value">{row.pct}&nbsp;%</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="pt-data__note">72 sur 246 n'ont aucun site. Parmi celles avec un site, 1/2 ont un défaut visible en 30 secondes. Le plus fréquent : non optimisé sur téléphone alors que 60&nbsp;% du trafic web vient du mobile.</p>
			</div>
		</div>
	</section>

	<main>
		<section class="section pt-work">
			<CompactLabel text="Ce que je fais" />
			<h2 class="pt-h2">La stratégie d'un site web qui parle à vos clients</h2>
			<p class="pt-body">
				Un acheteur compare trois prestataires. Il passe moins d'une minute sur chaque site et cherche trois
				choses :
			</p>
			<ul class="pt-numbered-list">
				<li><span class="badge pt-inline-badge">1</span> Est-ce que vous faites ce dont j'ai besoin</li>
				<li><span class="badge pt-inline-badge">2</span> Est-ce que vous êtes sérieux</li>
				<li><span class="badge pt-inline-badge">3</span> Comment je vous joins</li>
			</ul>

			<div class="pt-card-grid">
				<div class="pt-card">
					<div class="pt-card__icon icon-mask icon-mask--on-light pt-card__icon--langage" aria-hidden="true"></div>
					<h3 class="pt-card__label">Langage</h3>
					<p class="pt-card__text">« Nos solutions » devient ce que vous faites.</p>
				</div>
				<div class="pt-card">
					<div class="pt-card__icon icon-mask icon-mask--on-light pt-card__icon--univers" aria-hidden="true"></div>
					<h3 class="pt-card__label">Univers</h3>
					<p class="pt-card__text">Le ton et les visuels racontent la même histoire.</p>
				</div>
				<div class="pt-card">
					<div class="pt-card__icon icon-mask icon-mask--on-light pt-card__icon--parcours" aria-hidden="true"></div>
					<h3 class="pt-card__label">Parcours</h3>
					<p class="pt-card__text">Une seule action clé par page. Navigation optimisée.</p>
				</div>
			</div>

			<a class="btn btn--primary pt-section-cta" href={previewMailtoHref} target="_blank" rel="noopener noreferrer">Voir à quoi mon site pourrait ressembler</a>
		</section>

		<section class="section pt-travaux">
			<CompactLabel text="Travaux" />
			<h2 class="pt-h2">Mes réalisations</h2>
			<div class="pt-travaux__grid">
				{gemilio.data.galleryImages?.map((src, i) => (
					<div class="pt-travaux__item">
						<Image src={src} alt={`${gemilio.data.name} — visuel ${i + 1}`} width={600} loading="lazy" />
					</div>
				))}
			</div>
			<div class="pt-travaux__meta">
				{gemilio.data.testimonial && (
					<figure class="pt-testimonial pt-travaux__testimonial">
						<blockquote class="pt-testimonial__quote">«&nbsp;{gemilio.data.testimonial.quote}&nbsp;»</blockquote>
						<figcaption class="pt-testimonial__attribution">
							<span class="pt-testimonial__author">{gemilio.data.testimonial.author}</span>
							{gemilio.data.testimonial.role && <span class="diamond" aria-hidden="true"></span>}
							{gemilio.data.testimonial.role && <span class="pt-testimonial__role">{gemilio.data.testimonial.role}</span>}
						</figcaption>
					</figure>
				)}
				<div class="pt-travaux__info">
					<h3 class="pt-travaux__name">{gemilio.data.name}</h3>
					<p class="pt-travaux__overview">{gemilio.data.overview}</p>
					{gemilio.data.liveUrl && (
						<a class="text-link" href={gemilio.data.liveUrl} target="_blank" rel="noopener noreferrer">Voir en live →</a>
					)}
				</div>
			</div>
		</section>

		<section class="section pt-offers">
			<CompactLabel text="Offres" />
			<h2 class="pt-h2">Travailler ensemble</h2>

			<div class="pt-offer-list">
				<div class="pt-offer">
					<div class="pt-offer__text">
						<h3 class="pt-offer__title">Refonte complète</h3>
						<p class="pt-offer__desc">Stratégie, univers graphique, contenu, développement, SEO. 1 mois.</p>
					</div>
					<p class="pt-offer__price">À partir de 2 500 €</p>
				</div>
				<div class="pt-offer">
					<div class="pt-offer__text">
						<h3 class="pt-offer__title">Abonnement</h3>
						<p class="pt-offer__desc">Maintenance, SEO, contenu mensuel, analyse de performance et optimisations.</p>
					</div>
					<p class="pt-offer__price">150–350 € / mois</p>
				</div>
			</div>
		</section>

		<section class="section pt-about">
			<div class="pt-about__layout">
				<div class="pt-about__content">
					<CompactLabel text="Qui je suis" />
					<h2 class="pt-h2">Webmaster</h2>
					<p class="pt-body">
						Chimiste de formation, passé par le laboratoire. J'ai travaillé sur plusieurs projets et motifs
						moléculaires, dont certains ont mené à des publications.
					</p>
					<p class="pt-citation">
						<span class="pt-about__icon icon-mask icon-mask--on-light pt-about__icon--molecule" aria-hidden="true"></span>
						co-auteur — <em>Eur. J. Org. Chem.</em>
						<a class="badge pt-citation__badge" href="https://doi.org/10.1002/ejoc.202500083" target="_blank" rel="noopener noreferrer">Voir</a>
					</p>
					<p class="pt-body">
						Je suis passionnée de sciences et d'informatique. Je comprends une fiche technique sans qu'on me la
						reformule. Je travaille à distance, principalement par écrit.
					</p>
				</div>
				<img class="pt-about__photo" src="/images/photo-profil.png" alt="Alexandre Lobo" />
			</div>
		</section>

		<section class="section pt-process">
			<CompactLabel text="Comment ça se passe" srHeading />
			<div class="pt-lines">
				<p>Je vous envoie une direction pour votre page d'accueil, sous 48 h.</p>
				<p>Si ça vous parle, on parle stratégie, on parle chiffres. Sinon vous gardez l'aperçu.</p>
			</div>
			<a class="btn btn--primary pt-section-cta" href={previewMailtoHref} target="_blank" rel="noopener noreferrer">Voir à quoi mon site pourrait ressembler</a>
		</section>
	</main>

	<Footer />
</Layout>

<style define:vars={iconUrls}>
	.pt-hero {
		background: linear-gradient(135deg, #00259e 0%, #001e7e 100%);
	}

	.pt-hero__inner {
		max-width: 1400px;
		margin: 0 auto;
		padding: 64px 48px 96px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: start;
		gap: 64px;
	}

	.pt-hero__main {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 40px;
	}

	.pt-hero__title {
		margin: 0;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1.15;
		color: #fff;
		font-size: clamp(3rem, 5.5vw, 4.25rem);
	}

	.pt-hero__subtitle {
		margin: 0;
		max-width: 480px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: #fff;
	}

	.pt-hero__icon {
		display: inline-block;
		width: 0.72em;
		height: 0.72em;
		margin: 0 0.16em;
		vertical-align: -0.06em;
	}

	.pt-hero__icon--web {
		-webkit-mask-image: var(--webIconUrl);
		mask-image: var(--webIconUrl);
	}

	.pt-hero__icon--atom {
		-webkit-mask-image: var(--atomIconUrl);
		mask-image: var(--atomIconUrl);
		transform: rotate(4deg);
	}

	.pt-hero__visual {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.pt-data {
		width: 100%;
		background: #fff;
		border: 1px solid #e5e5e5;
		border-radius: 8px;
		padding: 32px;
	}

	.pt-data__note {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: rgba(255, 255, 255, 0.85);
	}

	.pt-data__caption {
		margin: 0 0 20px;
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #00259e;
	}

	.pt-data__table {
		width: 100%;
		border-collapse: collapse;
	}

	.pt-data__table tr + tr {
		border-top: 1px solid #e5e5e5;
	}

	.pt-data__label {
		padding: 8px 12px 8px 0;
		text-align: left;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.8125rem;
		letter-spacing: -0.03em;
		color: #333333;
		white-space: nowrap;
	}

	.pt-data__mark {
		margin-left: 6px;
		color: #5a6488;
		font-size: 0.7em;
	}

	.pt-data__cell {
		width: 100%;
		padding: 8px 12px;
	}

	.pt-data__track {
		position: relative;
		height: 20px;
		background: #e5e5e5;
		border-radius: 4px;
		overflow: hidden;
	}

	.pt-data__bar {
		height: 100%;
		min-width: 32px;
		background: #00259e;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		padding-left: 8px;
		box-sizing: border-box;
	}

	.pt-data__count {
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.75rem;
		color: #fff;
		font-variant-numeric: tabular-nums;
	}

	.pt-data__value {
		padding: 8px 0 8px 12px;
		text-align: right;
		white-space: nowrap;
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		font-size: 0.8125rem;
		letter-spacing: -0.03em;
		color: #00259e;
		font-variant-numeric: tabular-nums;
	}

	.pt-hero__cta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
	}

	.pt-hero__ctanote {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		letter-spacing: -0.03em;
		color: rgba(255, 255, 255, 0.7);
	}

	.pt-work {
		padding-top: 64px;
	}

	.pt-h2 {
		margin: 0 0 24px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.06;
		color: #00259e;
		font-size: clamp(2.25rem, 4vw, 3rem);
	}

	.pt-body {
		margin: 0 0 24px;
		max-width: 680px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.6;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.pt-body:last-of-type {
		margin-bottom: 0;
	}

	.pt-inline-badge {
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		padding: 0;
		border-radius: 4px;
		font-size: 0.6875rem;
	}

	.pt-numbered-list {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.pt-numbered-list li {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.pt-lines {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.pt-lines p {
		margin: 0;
		max-width: 680px;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.6;
		color: #333333;
		font-size: 1rem;
	}

	.pt-section-cta {
		margin-top: 40px;
	}

	.pt-card-grid {
		margin: 40px 0 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.pt-card {
		position: relative;
		overflow: hidden;
		background: #fff;
		border: 1px solid #e5e5e5;
		padding: 32px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.pt-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: -60%;
		width: 40%;
		height: 100%;
		background: linear-gradient(135deg, rgba(0, 37, 158, 0) 0%, rgba(0, 37, 158, 0.025) 50%, rgba(0, 37, 158, 0) 100%);
		pointer-events: none;
	}

	.pt-card:hover::before {
		animation: card-shine 0.35s ease-out;
	}

	@keyframes card-shine {
		0% {
			left: -60%;
		}
		100% {
			left: 120%;
		}
	}

	.pt-card__icon {
		width: 48px;
		height: 48px;
		margin-bottom: 8px;
	}

	.pt-card__icon--langage {
		-webkit-mask-image: var(--langageIconUrl);
		mask-image: var(--langageIconUrl);
	}

	.pt-card__icon--parcours {
		-webkit-mask-image: var(--parcoursIconUrl);
		mask-image: var(--parcoursIconUrl);
	}

	.pt-card__icon--univers {
		-webkit-mask-image: var(--universIconUrl);
		mask-image: var(--universIconUrl);
	}

	.pt-card__label {
		margin: 0;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: #00259e;
		font-size: 1.25rem;
	}

	.pt-card__text {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.pt-offers {
		padding-top: 0;
	}

	.pt-offer-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.pt-offer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		background: #fff;
		border: 1px solid #e5e5e5;
		padding: 32px;
	}

	.pt-offer__title {
		margin: 0 0 8px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		font-size: 1.5rem;
		color: #00259e;
	}

	.pt-offer__desc {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	.pt-offer__price {
		margin: 0;
		flex-shrink: 0;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1.15;
		font-size: 1.5rem;
		color: #00259e;
	}

	.pt-travaux__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.pt-travaux__item {
		aspect-ratio: 1 / 1;
		overflow: hidden;
	}

	.pt-travaux__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
		transition: transform 0.4s ease-out;
	}

