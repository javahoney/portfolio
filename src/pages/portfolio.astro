---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";

const email = "contact@alexandre-lobo.com";
const subject = "Démarrer un projet";
const body = `Bonjour Alexandre,

Je souhaite échanger sur un projet de site web.

Type de projet :
Délai souhaité :
Budget approximatif :

Quelques précisions sur mon activité et mon besoin :


Merci !`;
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const projectEntries = await getCollection("projects");
const projects = projectEntries
	.map((entry) => ({ id: entry.id, ...entry.data }))
	.sort((a, b) => a.order - b.order);

const description =
	"Conception de sites vitrines performants pour indépendants et petites entreprises. Un process clair, du design à la mise en ligne, et une autonomie totale pour piloter votre site une fois livré.";
---

<Layout title="Portfolio — Alexandre Lobo" description={description}>
	<main>
		<section class="hero">
			<p class="eyebrow">Alexandre Lobo</p>
			<h1 class="hero__title">Un site performant,<br />que vous pilotez seul</h1>
			<a class="btn btn--primary btn--cta" href={mailtoHref} target="_blank" rel="noopener noreferrer">Démarrer un projet</a>
		</section>

		<section class="section" id="projets">
			<SectionTitle text="Réalisations / 2026" />

			<div class="projects">
				{projects.map((project) => (
					<a class="project" href={`/projets/${project.id}`}>
						<div class="project__media">
							{project.mainImage ? (
								<img class="project__media-inner" src={project.mainImage} alt={project.name} />
							) : (
								<div class="project__media-inner" aria-hidden="true"></div>
							)}
						</div>
						<h3 class="project__name">{project.name}</h3>
						<p class="project__meta">{project.category}</p>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		max-width: 1400px;
		margin: 0 auto;
		padding: 96px 48px 160px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}

	.hero__title {
		margin: 0;
		font-family: "Cormorant Garamond", serif;
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.02;
		color: #00259e;
		font-size: clamp(3.5rem, 8vw, 4.5rem);
	}

	.btn--cta {
		margin-top: 16px;
	}

	.projects {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.project {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.project__media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.project__media-inner {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
		background: linear-gradient(135deg, #dde5f0, #c2cee0);
		transition: transform 0.4s ease-out;
	}

	.project:hover .project__media-inner {
		transform: scale(1.03);
	}

	.project__name {
		margin: 16px 0 8px;
		font-family: "Cormorant Garamond", serif;
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.15;
		font-size: 1.5rem;
		color: #00259e;
	}

	.project__meta {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	@media (max-width: 640px) {
		.hero {
			padding: 64px 12px 96px;
			gap: 16px;
		}

		.hero__title {
			font-size: 3rem;
		}

		.projects {
			grid-template-columns: 1fr;
		}

		.project__media {
			aspect-ratio: 1 / 1;
		}

		.project__name {
			margin-top: 8px;
		}
	}
</style>
