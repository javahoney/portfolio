---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";

const email = "contact@alexandre-lobo.com";
const subject = "Démarrer un projet";
const body = `Bonjour Alexandre,

Je souhaite échanger sur un projet de site web.

Type de projet :
Délai souhaité :
Budget approximatif :

Quelques précisions sur mon activité et mon besoin :


Merci !`;
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const projectEntries = await getCollection("projects");
const projects = projectEntries
	.map((entry) => ({ id: entry.id, ...entry.data }))
	.sort((a, b) => a.order - b.order);

const description =
	"Portfolio de sites web conçus par Alexandre Lobo pour des indépendants et petites entreprises : design, développement et référencement.";

const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Projets — Alexandre Lobo",
	description,
	mainEntity: {
		"@type": "ItemList",
		itemListElement: projects.map((project, index) => ({
			"@type": "ListItem",
			position: index + 1,
			url: `https://alexandre-lobo.com/projets/${project.id}`,
			name: project.name,
		})),
	},
};
---

<Layout
	title="Projets — Alexandre Lobo"
	description={description}
	image={projects[0]?.mainImage?.src}
	structuredData={collectionSchema}
>
	<Topbar href={mailtoHref} variant="on-light" links={[]} />

	<main>
		<section class="hero">
			<h1 class="hero__title">Tous les projets</h1>
			<a class="btn btn--primary" href={mailtoHref} target="_blank" rel="noopener noreferrer">Démarrer un projet</a>
		</section>

		<section class="section" id="projets">
			<SectionTitle text="Réalisations / 2026" />

			<div class="projects">
				{projects.map((project) => (
					<a class="project" href={`/projets/${project.id}`}>
						<div class="project__media">
							{project.mainImage ? (
								<Image class="project__media-inner" src={project.mainImage} alt={project.name} width={800} loading="lazy" />
							) : (
								<div class="project__media-inner" aria-hidden="true"></div>
							)}
						</div>
						<h3 class="project__name">{project.name}</h3>
						<p class="project__meta">{project.category}</p>
					</a>
				))}
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.hero {
		max-width: 1400px;
		margin: 0 auto;
		padding: 64px 48px 160px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 64px;
	}

	.hero__title {
		margin: 0;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1.02;
		color: #00259e;
		font-size: clamp(3rem, 5.5vw, 4.25rem);
	}

	.projects {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.project {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.project__media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.project__media-inner {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
		background: linear-gradient(135deg, #dde5f0, #c2cee0);
		transition: transform 0.4s ease-out;
	}

	.project:hover .project__media-inner {
		transform: scale(1.03);
	}

	.project__name {
		margin: 16px 0 8px;
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
		font-size: 1.5rem;
		color: #00259e;
	}

	.project__meta {
		margin: 0;
		font-family: "Montserrat", sans-serif;
		font-weight: 500;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.03em;
		color: #333333;
	}

	@media (max-width: 640px) {
		.hero {
			padding: 40px 12px 96px;
			gap: 24px;
		}

		.hero__title {
			font-size: 2.5rem;
		}

		.projects {
			grid-template-columns: 1fr;
		}

		.project__media {
			aspect-ratio: 1 / 1;
		}

		.project__name {
			margin-top: 8px;
		}
	}
</style>
